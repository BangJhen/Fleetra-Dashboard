# Local MVP only. Generate your own long random secret before sharing the app.
SESSION_SECRET=
# Optional Mobile integration. Never put this in NEXT_PUBLIC variables.
MOBILE_DEMO_TOKEN=
MOBILE_DEMO_DRIVER_ID=d1
# Writable local directory. Single Node process only; use a real DB for deployment.
FLEETRA_DATA_DIR=.data
# Optional MapLibre style URL; default is the local Fleetra places style.
NEXT_PUBLIC_MAP_STYLE_URL=/maps/fleetra-places.json
